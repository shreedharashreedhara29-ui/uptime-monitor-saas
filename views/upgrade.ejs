<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Upgrade to Pro - Uptime Monitor</title>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <style>
        :root {
            --primary: #4f46e5;
            --primary-hover: #4338ca;
            --bg: #f8fafc;
            --card-bg: #ffffff;
            --text-main: #0f172a;
            --border: #e2e8f0;
        }
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }
        body {
            background-color: var(--bg);
            color: var(--text-main);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 16px;
        }
        .pricing-card {
            background: var(--card-bg);
            border: 2px solid var(--primary);
            border-radius: 16px;
            padding: 24px;
            max-width: 420px;
            width: 100%;
            text-align: center;
            box-shadow: 0 10px 25px rgba(79, 70, 229, 0.1);
        }
        .badge {
            background: #e0e7ff;
            color: var(--primary);
            padding: 6px 14px;
            border-radius: 9999px;
            font-size: 13px;
            font-weight: 700;
            display: inline-block;
            margin-bottom: 12px;
        }
        .price {
            font-size: 36px;
            font-weight: 800;
            margin-bottom: 6px;
        }
        .price span {
            font-size: 15px;
            color: #64748b;
            font-weight: 500;
        }
        .features {
            list-style: none;
            text-align: left;
            margin: 20px 0;
        }
        .features li {
            padding: 10px 0;
            border-bottom: 1px solid var(--border);
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .features li:last-child {
            border-bottom: none;
        }
        .btn-upgrade {
            display: block;
            width: 100%;
            background-color: var(--primary);
            color: white;
            border: none;
            padding: 14px 20px;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s;
        }
        .btn-upgrade:hover {
            background-color: var(--primary-hover);
        }
        .back-link {
            display: inline-block;
            margin-top: 16px;
            color: #64748b;
            text-decoration: none;
            font-size: 14px;
        }
        .back-link:hover {
            color: var(--text-main);
        }
    </style>
</head>
<body>
    <div class="pricing-card">
        <span class="badge">PRO PLAN</span>
        <div class="price">₹199 <span>/ ತಿಂಗಳಿಗೆ</span></div>
        <p style="color: #64748b; font-size: 13px;">ನಿಮ್ಮ ಎಲ್ಲಾ ವೆಬ್‌ಸೈಟ್‌ಗಳ ನಿರಂತರ ಕಣ್ಗಾವಲಿಗಾಗಿ</p>

        <ul class="features">
            <li>⚡ ಗರಿಷ್ಠ 15 ವೆಬ್‌ಸೈಟ್‌ಗಳ ಮಾನಿಟರಿಂಗ್</li>
            <li>🚀 ಅಲ್ಟ್ರಾ-ಫಾಸ್ಟ್ 30 ಸೆಕೆಂಡ್ ಚೆಕಿಂಗ್</li>
            <li>📱 ತಕ್ಷಣದ ಟೆಲಿಗ್ರಾಂ ಅಲರ್ಟ್ ನೋಟಿಫಿಕೇಶನ್</li>
            <li>📊 ವಿವರವಾದ ರೆಸ್ಪಾನ್ಸ್ ಟೈಮ್ ಟ್ರ್ಯಾಕಿಂಗ್</li>
            <li>🛡️ 24/7 ನಿರಂತರ ಸರ್ವರ್ ಕಣ್ಗಾವಲು</li>
        </ul>

        <button id="pay-btn" class="btn-upgrade">₹199 ಪಾವತಿಸಿ ಅಪ್‌ಗ್ರೇಡ್ ಮಾಡಿ</button>
        <a href="/dashboard" class="back-link">← ಡ್ಯಾಶ್‌ಬೋರ್ಡ್‌ಗೆ ಹಿಂತಿರುಗಿ</a>
    </div>

    <script>
        document.getElementById('pay-btn').onclick = async function(e) {
            e.preventDefault();
            const btn = document.getElementById('pay-btn');
            btn.innerText = "ದಯವಿಟ್ಟು ಕಾಯಿರಿ...";
            btn.disabled = true;

            try {
                const res = await fetch('/create-order', { method: 'POST' });
                const orderData = await res.json();

                if (!orderData.orderId) {
                    alert('Order ID ರಚಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ!');
                    btn.innerText = "₹199 ಪಾವತಿಸಿ ಅಪ್‌ಗ್ರೇಡ್ ಮಾಡಿ";
                    btn.disabled = false;
                    return;
                }

                var options = {
                    "key": "rzp_test_TsyKVhtJy6q6B5",
                    "amount": 19900,
                    "currency": "INR",
                    "name": "Uptime Monitor",
                    "description": "Pro Plan Subscription",
                    "order_id": orderData.orderId,
                    "handler": function (response){
                        fetch('/razorpay-success', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                payment_id: response.razorpay_payment_id,
                                order_id: response.razorpay_order_id
                            })
                        }).then(r => r.json()).then(data => {
                            if(data.success) {
                                alert('ಅಭಿನಂದನೆಗಳು! ಪಾವತಿ ಯಶಸ್ವಿಯಾಗಿದೆ. ನಿಮ್ಮ ಖಾತೆಯನ್ನು PRO ಪ್ಲಾನ್‌ಗೆ ಅಪ್‌ಗ್ರೇಡ್ ಮಾಡಲಾಗಿದೆ.');
                                window.location.href = '/dashboard';
                            }
                        });
                    },
                    "modal": {
                        "ondismiss": function() {
                            btn.innerText = "₹199 ಪಾವತಿಸಿ ಅಪ್‌ಗ್ರೇಡ್ ಮಾಡಿ";
                            btn.disabled = false;
                        }
                    },
                    "theme": {
                        "color": "#4f46e5"
                    }
                };

                var rzp1 = new Razorpay(options);
                rzp1.open();
            } catch (err) {
                alert('ದೋಷ ಎದುರಾಗಿದೆ, ದಯವಿಟ್ಟು ಪುನಃ ಪ್ರಯತ್ನಿಸಿ.');
                btn.innerText = "₹199 ಪಾವತಿಸಿ ಅಪ್‌ಗ್ರೇಡ್ ಮಾಡಿ";
                btn.disabled = false;
            }
        };
    </script>
</body>
</html>
