<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pingbaba - Next-Gen Uptime & Multi-Channel Alerts</title>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <style>
        :root {
            --bg-main: #070d1e;
            --card-bg: rgba(16, 27, 60, 0.75);
            --border-color: rgba(56, 189, 248, 0.2);
            --primary-blue: #2563eb;
            --cyan-glow: #38bdf8;
            --success: #22c55e;
            --danger: #ef4444;
        }
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }
        body {
            background-color: var(--bg-main);
            background-image: radial-gradient(circle at 50% 0%, rgba(37, 99, 235, 0.25) 0%, transparent 60%);
            color: #ffffff;
            min-height: 100vh;
            padding: 30px 20px;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
        }
        header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-bottom: 24px;
            border-bottom: 1px solid var(--border-color);
            margin-bottom: 30px;
        }
        .brand-section {
            display: flex;
            align-items: center;
            gap: 16px;
        }
        .logo-box {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, #1d4ed8, #0ea5e9);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
            box-shadow: 0 0 20px rgba(14, 165, 233, 0.5);
        }
        .brand-text h1 {
            font-size: 28px;
            font-weight: 800;
        }
        .brand-text h1 span {
            color: var(--cyan-glow);
        }
        .brand-text p {
            font-size: 13px;
            color: #94a3b8;
        }
        .plan-badge {
            background: rgba(14, 165, 233, 0.15);
            color: var(--cyan-glow);
            padding: 8px 18px;
            border-radius: 30px;
            font-size: 14px;
            font-weight: 700;
            border: 1px solid var(--cyan-glow);
            box-shadow: 0 0 12px rgba(14, 165, 233, 0.3);
        }
        .pricing-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 20px;
            margin-bottom: 35px;
        }
        .pricing-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 24px;
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
            position: relative;
        }
        .pricing-card:hover {
            transform: translateY(-5px);
            border-color: var(--cyan-glow);
        }
        .pricing-card.active-card {
            border-color: var(--cyan-glow);
            box-shadow: 0 0 20px rgba(56, 189, 248, 0.25);
        }
        .plan-name {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 8px;
        }
        .plan-price {
            font-size: 32px;
            font-weight: 800;
            color: var(--cyan-glow);
            margin-bottom: 16px;
        }
        .plan-features {
            list-style: none;
            margin-bottom: 24px;
            font-size: 13px;
            color: #cbd5e1;
        }
        .plan-features li {
            margin-bottom: 9px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .badge-alert {
            display: inline-block;
            font-size: 11px;
            padding: 2px 7px;
            border-radius: 5px;
            margin-left: 5px;
            font-weight: bold;
        }
        .b-wa { background: #22c55e22; color: #4ade80; border: 1px solid #22c55e; }
        .b-sms { background: #eab30822; color: #fde047; border: 1px solid #eab308; }
        .b-email { background: #38bdf822; color: #38bdf8; border: 1px solid #38bdf8; }
        .btn-upgrade {
            width: 100%;
            padding: 12px;
            background: linear-gradient(135deg, #2563eb, #0284c7);
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
        }
        .btn-active-plan {
            width: 100%;
            padding: 12px;
            background: rgba(255, 255, 255, 0.05);
            color: #94a3b8;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            font-size: 15px;
            font-weight: 700;
            cursor: default;
        }
        .dashboard-grid {
            display: grid;
            grid-template-columns: 360px 1fr;
            gap: 25px;
        }
        @media (max-width: 900px) {
            .dashboard-grid { grid-template-columns: 1fr; }
        }
        .panel {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 24px;
            backdrop-filter: blur(10px);
        }
        .panel h2 {
            font-size: 20px;
            margin-bottom: 20px;
            font-weight: 700;
        }
        .form-group {
            margin-bottom: 15px;
        }
        label {
            display: block;
            font-size: 13px;
            color: #94a3b8;
            margin-bottom: 6px;
        }
        input {
            width: 100%;
            padding: 11px 13px;
            background: rgba(7, 13, 30, 0.8);
            border: 1px solid rgba(56, 189, 248, 0.3);
            border-radius: 10px;
            color: #fff;
            outline: none;
            font-size: 14px;
        }
        .btn-submit {
            width: 100%;
            padding: 13px;
            background: linear-gradient(135deg, #2563eb, #38bdf8);
            color: #fff;
            border: none;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            margin-top: 5px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        th, td {
            padding: 14px 12px;
            text-align: left;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            font-size: 14px;
        }
        th { color: #64748b; font-size: 12px; text-transform: uppercase; }
        .status-badge {
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
        }
        .status-up { background: rgba(34, 197, 94, 0.2); color: #4ade80; border: 1px solid #22c55e; }
        .status-down { background: rgba(239, 68, 68, 0.2); color: #f87171; border: 1px solid #ef4444; }
        .btn-del {
            background: none;
            border: none;
            color: #f87171;
            font-weight: 600;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <div class="brand-section">
                <div class="logo-box">🔔</div>
                <div class="brand-text">
                    <h1>Ping<span>baba</span></h1>
                    <p>Next-Gen Uptime & Multi-Channel Alert Engine</p>
                </div>
            </div>
            <div class="plan-badge">
                CURRENT PLAN: <%= userPlan.toUpperCase() %>
            </div>
        </header>

        <div class="pricing-grid">
            <!-- Free Plan -->
            <div class="pricing-card <%= userPlan === 'free' ? 'active-card' : '' %>">
                <div class="plan-name">Free</div>
                <div class="plan-price">₹0</div>
                <ul class="plan-features">
                    <li>✓ 1 Website Monitoring</li>
                    <li>✓ 10 Minutes Interval</li>
                    <li>✓ Dashboard Only (No instant alerts)</li>
                </ul>
                <button class="btn-active-plan"><%= userPlan === 'free' ? 'Active Plan' : 'Free' %></button>
            </div>

            <!-- Lite Plan -->
            <div class="pricing-card <%= userPlan === 'lite' ? 'active-card' : '' %>">
                <div class="plan-name">Lite</div>
                <div class="plan-price">₹199<span style="font-size: 14px; color: #94a3b8;">/mo</span></div>
                <ul class="plan-features">
                    <li>✓ 10 Websites Monitoring</li>
                    <li>✓ 30 Seconds Interval</li>
                    <li>✓ <span class="badge-alert b-wa">WhatsApp Alert</span></li>
                </ul>
                <% if (userPlan === 'lite') { %>
                    <button class="btn-active-plan">Active Plan</button>
                <% } else { %>
                    <button class="btn-upgrade" onclick="buySubscription('lite')">Upgrade to Lite</button>
                <% } %>
            </div>

            <!-- Pro Plan -->
            <div class="pricing-card <%= userPlan === 'pro' ? 'active-card' : '' %>">
                <div class="plan-name">Pro</div>
                <div class="plan-price">₹349<span style="font-size: 14px; color: #94a3b8;">/mo</span></div>
                <ul class="plan-features">
                    <li>✓ 25 Websites Monitoring</li>
                    <li>✓ 15 Seconds Speed Check</li>
                    <li>✓ <span class="badge-alert b-wa">WhatsApp</span> + <span class="badge-alert b-sms">SMS Alert</span></li>
                </ul>
                <% if (userPlan === 'pro') { %>
                    <button class="btn-active-plan">Active Plan</button>
                <% } else { %>
                    <button class="btn-upgrade" onclick="buySubscription('pro')">Upgrade to Pro</button>
                <% } %>
            </div>

            <!-- Ultra Pro Plan -->
            <div class="pricing-card <%= userPlan === 'ultra_pro' ? 'active-card' : '' %>">
                <div class="plan-name">Ultra Pro</div>
                <div class="plan-price">₹599<span style="font-size: 14px; color: #94a3b8;">/mo</span></div>
                <ul class="plan-features">
                    <li>✓ Unlimited Websites</li>
                    <li>✓ 5 Seconds Turbo Check</li>
                    <li>✓ <span class="badge-alert b-wa">WhatsApp</span> + <span class="badge-alert b-sms">SMS</span> + <span class="badge-alert b-email">Email</span></li>
                </ul>
                <% if (userPlan === 'ultra_pro') { %>
                    <button class="btn-active-plan">Active Plan</button>
                <% } else { %>
                    <button class="btn-upgrade" onclick="buySubscription('ultra_pro')">Upgrade to Ultra Pro</button>
                <% } %>
            </div>
        </div>

        <div class="dashboard-grid">
            <div class="panel">
                <h2>Add Website</h2>
                <form action="/add-website" method="POST">
                    <div class="form-group">
                        <label>Website Name</label>
                        <input type="text" name="name" placeholder="My Blog / Store" required>
                    </div>
                    <div class="form-group">
                        <label>Website URL</label>
                        <input type="text" name="url" placeholder="https://example.com" required>
                    </div>
                    <div class="form-group">
                        <label>WhatsApp / Mobile Number (with 91)</label>
                        <input type="text" name="phone" placeholder="918618957072" required>
                    </div>
                    <div class="form-group">
                        <label>Email ID (for Ultra Pro alerts)</label>
                        <input type="email" name="email" placeholder="owner@example.com">
                    </div>
                    <button type="submit" class="btn-submit">Start Monitoring</button>
                </form>
            </div>

            <div class="panel">
                <h2>Monitored Websites (<%= websites.length %>)</h2>
                <table>
                    <thead>
                        <tr>
                            <th>Website</th>
                            <th>Status</th>
                            <th>Last Checked</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (websites.length === 0) { %>
                            <tr><td colspan="4" style="text-align: center; color: #64748b; padding: 30px;">ಯಾವುದೇ ವೆಬ್‌ಸೈಟ್ ಸೇರಿಸಲಾಗಿಲ್ಲ</td></tr>
                        <% } else { %>
                            <% websites.forEach(function(site) { %>
                                <tr>
                                    <td>
                                        <strong><%= site.name %></strong><br>
                                        <span style="font-size: 12px; color: #64748b;"><%= site.url %></span>
                                    </td>
                                    <td>
                                        <span class="status-badge <%= site.status === 'UP' ? 'status-up' : 'status-down' %>">
                                            <%= site.status %>
                                        </span>
                                    </td>
                                    <td style="color: #94a3b8;"><%= site.lastChecked %></td>
                                    <td>
                                        <form action="/delete-website/<%= site.id %>" method="POST">
                                            <button type="submit" class="btn-del">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        function fireConfettiBlast() {
            var duration = 4 * 1000;
            var end = Date.now() + duration;

            (function frame() {
                confetti({ particleCount: 7, angle: 60, spread: 55, origin: { x: 0 } });
                confetti({ particleCount: 7, angle: 120, spread: 55, origin: { x: 1 } });
                if (Date.now() < end) requestAnimationFrame(frame);
            }());
        }

        async function buySubscription(planId) {
            try {
                const response = await fetch('/api/create-order', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ planId })
                });
                const data = await response.json();

                if (!data.success) {
                    alert('ಆರ್ಡರ್ ತೆರೆಯಲು ಸಾಧ್ಯವಾಗುತ್ತಿಲ್ಲ: ' + data.message);
                    return;
                }

                const options = {
                    key: data.keyId,
                    amount: data.amount,
                    currency: "INR",
                    name: "Pingbaba Pro",
                    description: data.planName + " Plan Subscription",
                    order_id: data.orderId,
                    handler: async function (paymentResponse) {
                        const verifyRes = await fetch('/api/verify-payment', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                razorpay_order_id: paymentResponse.razorpay_order_id,
                                razorpay_payment_id: paymentResponse.razorpay_payment_id,
                                razorpay_signature: paymentResponse.razorpay_signature,
                                planId: planId
                            })
                        });
                        const verifyData = await verifyRes.json();
                        if (verifyData.success) {
                            fireConfettiBlast();
                            setTimeout(() => {
                                alert(verifyData.message);
                                location.reload();
                            }, 1500);
                        } else {
                            alert('ದೃಢೀಕರಣ ವಿಫಲವಾಗಿದೆ: ' + verifyData.message);
                        }
                    },
                    theme: { color: "#2563eb" }
                };

                const rzp = new Razorpay(options);
                rzp.open();
            } catch (err) {
                alert('ಪೇಮೆಂಟ್ ಗೇಟ್‌ವೇ ಲೋಡ್ ಆಗುತ್ತಿಲ್ಲ.');
            }
        }
    </script>
</body>
</html>
