<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pingbaba - Website Uptime & WhatsApp Alert System</title>
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><circle cx='50' cy='50' r='45' fill='%232563eb'/><path d='M25 55 L40 70 L75 35' stroke='white' stroke-width='10' fill='none' stroke-linecap='round'/></svg>">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }
        body {
            background-color: #0b132b;
            color: #ffffff;
            min-height: 100vh;
            padding: 24px;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
        }
        
        /* ಹೊಸ ಆಧುನಿಕ ಹೆಡರ್ ಮತ್ತು ಲೋಗೋ ವಿನ್ಯಾಸ */
        header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-bottom: 24px;
            border-bottom: 1px solid #1c2541;
            margin-bottom: 30px;
        }
        .brand-section {
            display: flex;
            align-items: center;
            gap: 14px;
        }
        .logo-box {
            width: 44px;
            height: 44px;
            background: linear-gradient(135deg, #2563eb, #38bdf8);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.4);
        }
        .brand-text h1 {
            font-size: 24px;
            font-weight: 800;
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .brand-text h1 span {
            color: #38bdf8;
        }
        .brand-text p {
            font-size: 13px;
            color: #94a3b8;
            margin-top: 2px;
        }
        .system-badge {
            background: rgba(34, 197, 94, 0.1);
            color: #4ade80;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
            border: 1px solid rgba(74, 222, 128, 0.2);
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .status-dot {
            width: 8px;
            height: 8px;
            background-color: #4ade80;
            border-radius: 50%;
            display: inline-block;
            box-shadow: 0 0 8px #4ade80;
        }

        /* ಡ್ಯಾಶ್‌ಬೋರ್ಡ್ ಲೇಔಟ್ */
        .dashboard-grid {
            display: grid;
            grid-template-columns: 340px 1fr;
            gap: 24px;
        }
        @media (max-width: 900px) {
            .dashboard-grid {
                grid-template-columns: 1fr;
            }
        }
        .card {
            background-color: #111d42;
            border: 1px solid #1c2541;
            border-radius: 14px;
            padding: 24px;
        }
        .card h2 {
            font-size: 18px;
            margin-bottom: 20px;
            font-weight: 600;
        }

        /* ಫಾರ್ಮ್ ಎಲಿಮೆಂಟ್ಸ್ */
        .form-group {
            margin-bottom: 16px;
        }
        label {
            display: block;
            font-size: 13px;
            color: #94a3b8;
            margin-bottom: 6px;
        }
        input {
            width: 100%;
            padding: 10px 14px;
            background-color: #0b132b;
            border: 1px solid #233560;
            border-radius: 8px;
            color: #fff;
            font-size: 14px;
            outline: none;
        }
        input:focus {
            border-color: #38bdf8;
        }
        .btn-submit {
            width: 100%;
            padding: 11px;
            background: #2563eb;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            margin-top: 8px;
        }
        .btn-submit:hover {
            background: #1d4ed8;
        }

        /* ಟೇಬಲ್ */
        .table-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
        }
        .btn-refresh {
            background: none;
            border: none;
            color: #38bdf8;
            cursor: pointer;
            font-size: 13px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
        }
        th {
            text-align: left;
            padding: 12px 10px;
            color: #64748b;
            font-weight: 600;
            font-size: 12px;
            border-bottom: 1px solid #1c2541;
        }
        td {
            padding: 14px 10px;
            border-bottom: 1px solid #1c2541;
            vertical-align: middle;
        }
        .site-name {
            font-weight: 600;
            color: #fff;
        }
        .site-url {
            font-size: 12px;
            color: #64748b;
        }
        .badge-status {
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 700;
            display: inline-block;
        }
        .badge-up {
            background: rgba(34, 197, 94, 0.15);
            color: #4ade80;
        }
        .badge-pending {
            background: rgba(234, 179, 8, 0.15);
            color: #facc15;
        }
        .badge-down {
            background: rgba(239, 68, 68, 0.15);
            color: #f87171;
        }
        .btn-delete {
            color: #ef4444;
            background: none;
            border: none;
            cursor: pointer;
            font-size: 13px;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- ಹೊಸ ಲೋಗೋ ಮತ್ತು ಹೆಡರ್ -->
        <header>
            <div class="brand-section">
                <div class="logo-box">🔔</div>
                <div class="brand-text">
                    <h1>Ping<span>baba</span></h1>
                    <p>24x7 Website Uptime & WhatsApp Alert System</p>
                </div>
            </div>
            <div class="system-badge">
                <span class="status-dot"></span> System Active
            </div>
        </header>

        <!-- ಅಸಲಿ ಡ್ಯಾಶ್‌ಬೋರ್ಡ್ ಫಾರ್ಮ್ ಮತ್ತು ಟೇಬಲ್ -->
        <div class="dashboard-grid">
            <div class="card">
                <h2>Add Website</h2>
                <form action="/add-website" method="POST">
                    <div class="form-group">
                        <label>Website Name</label>
                        <input type="text" name="name" placeholder="e.g. Google" required>
                    </div>
                    <div class="form-group">
                        <label>Website URL</label>
                        <input type="url" name="url" placeholder="https://example.com" required>
                    </div>
                    <div class="form-group">
                        <label>WhatsApp Number</label>
                        <input type="text" name="phone" placeholder="918618957072" required>
                    </div>
                    <button type="submit" class="btn-submit">Start Monitoring</button>
                </form>
            </div>

            <div class="card">
                <div class="table-header">
                    <h2>Monitored Websites</h2>
                    <button class="btn-refresh" onclick="location.reload()">Refresh</button>
                </div>
                <table>
                    <thead>
                        <tr>
                            <th>WEBSITE</th>
                            <th>STATUS</th>
                            <th>LAST CHECKED</th>
                            <th>ACTION</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (typeof websites !== 'undefined' && websites.length > 0) { %>
                            <% websites.forEach(function(site) { %>
                                <tr>
                                    <td>
                                        <div class="site-name"><%= site.name %></div>
                                        <div class="site-url"><%= site.url %></div>
                                    </td>
                                    <td>
                                        <span class="badge-status <%= site.status === 'UP' ? 'badge-up' : (site.status === 'DOWN' ? 'badge-down' : 'badge-pending') %>">
                                            <%= site.status || 'PENDING' %>
                                        </span>
                                    </td>
                                    <td style="color: #94a3b8; font-size: 13px;"><%= site.lastChecked || 'Waiting...' %></td>
                                    <td>
                                        <form action="/delete-website/<%= site.id %>" method="POST" style="display:inline;">
                                            <button type="submit" class="btn-delete">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td>
                                    <div class="site-name">PingBaba</div>
                                    <div class="site-url">https://example.com</div>
                                </td>
                                <td><span class="badge-status badge-pending">PENDING</span></td>
                                <td style="color: #94a3b8; font-size: 13px;">Waiting...</td>
                                <td><button class="btn-delete">Delete</button></td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>
