<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Uptime Monitor SaaS</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }
        body {
            background-color: #0b1329;
            color: #ffffff;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 24px 16px;
            text-align: center;
        }
        .hero {
            max-width: 600px;
            width: 100%;
        }
        h1 {
            font-size: 26px;
            color: #38bdf8;
            margin-bottom: 12px;
            line-height: 1.3;
        }
        p.desc {
            color: #94a3b8;
            font-size: 14px;
            margin-bottom: 28px;
            line-height: 1.5;
        }
        .pricing-card {
            background: #1e293b;
            border: 1px solid #334155;
            border-radius: 16px;
            padding: 24px;
            margin-bottom: 24px;
            width: 100%;
        }
        .price-badge {
            font-size: 14px;
            color: #f59e0b;
            font-weight: 700;
            margin-bottom: 6px;
        }
        .price {
            font-size: 32px;
            font-weight: 800;
            margin-bottom: 16px;
        }
        .price span {
            font-size: 14px;
            color: #94a3b8;
            font-weight: 400;
        }
        .features {
            list-style: none;
            text-align: left;
            margin-bottom: 8px;
        }
        .features li {
            padding: 8px 0;
            color: #cbd5e1;
            font-size: 13px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .btn-group {
            display: flex;
            flex-direction: column;
            gap: 12px;
            width: 100%;
        }
        .btn-primary {
            background-color: #0284c7;
            color: white;
            text-decoration: none;
            padding: 14px;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 600;
            display: block;
        }
        .btn-secondary {
            background-color: #334155;
            color: white;
            text-decoration: none;
            padding: 14px;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 600;
            display: block;
        }
    </style>
</head>
<body>
    <div class="hero">
        <h1>ನಿಮ್ಮ ವೆಬ್‌ಸೈಟ್ ಡೌನ್ ಆದರೆ ತಕ್ಷಣ ತಿಳಿಯಿರಿ ⚡</h1>
        <p class="desc">ಭಾರತದ ಸಣ್ಣ ವ್ಯಾಪಾರಿಗಳು ಮತ್ತು ಡೆವಲಪರ್‌ಗಳಿಗಾಗಿ ನಿರ್ಮಿಸಲಾದ ಅತ್ಯಂತ ವೇಗದ ಮತ್ತು ಕೈಗೆಟುಕುವ Uptime Monitoring ಸೇವೆ.</p>

        <div class="pricing-card">
            <div class="price-badge">👑 Pro ಪ್ಲಾನ್</div>
            <div class="price">₹199 <span>/ ತಿಂಗಳಿಗೆ</span></div>
            <ul class="features">
                <li>✔ ಗರಿಷ್ಠ 15 ವೆಬ್‌ಸೈಟ್‌ಗಳು</li>
                <li>✔ ಅಲ್ಟ್ರಾ-ಫಾಸ್ಟ್ 30 ಸೆಕೆಂಡ್ ಚೆಕಿಂಗ್</li>
                <li>✔ ತಕ್ಷಣದ ಟೆಲಿಗ್ರಾಂ ಅಲರ್ಟ್ ನೋಟಿಫಿಕೇಶನ್</li>
                <li>✔ 24/7 ನಿರಂತರ ಕಣ್ಗಾವಲು</li>
            </ul>
        </div>

        <div class="btn-group">
            <a href="/signup" class="btn-primary">ಖಾತೆ ರಚಿಸಿ (ಉಚಿತ ಟ್ರಯಲ್)</a>
            <a href="/login" class="btn-secondary">ಲಾಗಿನ್ ಆಗಿ</a>
        </div>
    </div>
</body>
</html>
